{
  "name": "prompt-guess-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run sync && vite build && node scripts/stage-images.mjs && node scripts/check-dist.mjs",
    "pages:dev": "npm run sync && wrangler pages dev --port 8788",
    "test": "tsx --test test/*.test.ts",
    "play": "node scripts/play.mjs",
    "sync": "node scripts/sync-puzzles.mjs",
    "pretest": "npm run sync"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@cloudflare/workers-types": "^4.20250101.0",
    "playwright-core": "^1.64.0",
    "svelte": "^5.57.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.4",
    "wrangler": "^4.0.0"
  }
}
